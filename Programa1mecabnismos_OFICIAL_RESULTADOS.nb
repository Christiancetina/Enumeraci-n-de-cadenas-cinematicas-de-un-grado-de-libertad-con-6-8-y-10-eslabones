Notebook[{

Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"KinematicSynthesis", "[", 
    RowBox[{"Nlinks_Integer", ",", "Jjoints_Integer"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "F", ",", "qMax", ",", "eq1", ",", "eq2", ",", "vars", ",", "families", 
       ",", "combSpace", ",", "BocherPolynomial", ",", "FilterRigidSubchains",
        ",", "GetDegreeSequences", ",", 
       RowBox[{"validChains", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"totalMechanisms", "=", "0"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{
      "Print", "[", 
       "\"\<======================================================\>\"", 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{
      "Print", "[", 
       "\"\<      S\[CapitalIAcute]NTESIS CINEM\[CapitalAAcute]TICA Y AN\
\[CapitalAAcute]LISIS TOPOL\[CapitalOAcute]GICO       \>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
      "Print", "[", 
       "\"\<======================================================\>\"", 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"F", "=", 
       RowBox[{
        RowBox[{"3", "*", 
         RowBox[{"(", 
          RowBox[{"Nlinks", "-", "1"}], ")"}]}], "-", 
        RowBox[{"2", "*", "Jjoints"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"combSpace", "=", 
       RowBox[{"Binomial", "[", 
        RowBox[{
         RowBox[{"Nlinks", "*", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Nlinks", "-", "1"}], ")"}], "/", "2"}]}], ",", 
         "Jjoints"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<Eslabones (N): \>\"", ",", "Nlinks", ",", 
        "\"\< | Juntas (J): \>\"", ",", "Jjoints"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Grados de Libertad (F): \>\"", ",", "F"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<Espacio Combinatorio Te\[OAcute]rico: \>\"", ",", "combSpace"}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"F", "<", "0"}], ",", 
        RowBox[{
         RowBox[{
         "Print", "[", "\"\<[!] Error: Grados de libertad negativos.\>\"", 
          "]"}], ";", 
         RowBox[{"Return", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "1.", " ", "C\[AAcute]lculo", " ", "de", " ", "Familias", " ", 
        "Estructurales"}], "*)"}], 
      RowBox[{"qMax", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"F", "<=", "1"}], ",", 
         RowBox[{"Floor", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Nlinks", "-", "F", "+", "1"}], ")"}], "/", "2"}], "]"}], 
         ",", 
         RowBox[{"Min", "[", 
          RowBox[{
           RowBox[{"Nlinks", "-", "F", "-", "1"}], ",", 
           RowBox[{"Floor", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"Nlinks", "+", "F", "-", "1"}], ")"}], "/", "2"}], 
            "]"}]}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"vars", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Symbol", "[", 
          RowBox[{"\"\<n\>\"", "<>", 
           RowBox[{"ToString", "[", "i", "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "2", ",", "qMax"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"eq1", "=", 
       RowBox[{
        RowBox[{"Total", "[", "vars", "]"}], "==", "Nlinks"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"eq2", "=", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"i", "*", 
           RowBox[{"vars", "[", 
            RowBox[{"[", 
             RowBox[{"i", "-", "1"}], "]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "2", ",", "qMax"}], "}"}]}], "]"}], "==", 
        RowBox[{"2", "*", "Jjoints"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"families", "=", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"eq1", ",", "eq2", ",", 
           RowBox[{"And", "@@", 
            RowBox[{"Thread", "[", 
             RowBox[{"vars", ">=", "0"}], "]"}]}]}], "}"}], ",", "vars", ",", 
         "Integers"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<\\nFamilias Estructurales Encontradas (\>\"", ",", 
        RowBox[{"Row", "[", 
         RowBox[{"vars", ",", "\"\<, \>\""}], "]"}], ",", "\"\<):\>\""}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\< - Familia \>\"", ",", "k", ",", "\"\<: \>\"", ",", 
          RowBox[{"vars", "/.", " ", 
           RowBox[{"families", "[", 
            RowBox[{"[", "k", "]"}], "]"}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", 
          RowBox[{"Length", "[", "families", "]"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"2.", " ", "Pre"}], "-", 
        RowBox[{"filtro", " ", 
         RowBox[{"Algebraico", ":", 
          RowBox[{"Polinomio", " ", "de", " ", "Bocher"}]}]}]}], "*)"}], 
      RowBox[{
       RowBox[{"BocherPolynomial", "[", 
        RowBox[{"adj_", "?", "MatrixQ"}], "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"n", ",", "s", ",", "a", ",", "j", ",", "r"}], "}"}], ",", 
         RowBox[{
          RowBox[{"n", "=", 
           RowBox[{"Length", "[", "adj", "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"s", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Tr", "[", 
              RowBox[{"MatrixPower", "[", 
               RowBox[{"adj", ",", "r"}], "]"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"r", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"a", "=", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0", ",", 
             RowBox[{"n", "+", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"a", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "=", "1"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"j", "=", "1"}], ",", 
            RowBox[{"j", "<=", "n"}], ",", 
            RowBox[{"j", "++"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"a", "[", 
               RowBox[{"[", 
                RowBox[{"j", "+", "1"}], "]"}], "]"}], "=", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "1"}], "/", "j"}], "*", 
               RowBox[{"Sum", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"a", "[", 
                   RowBox[{"[", 
                    RowBox[{"j", "-", "r", "+", "1"}], "]"}], "]"}], "*", 
                  RowBox[{"s", "[", 
                   RowBox[{"[", "r", "]"}], "]"}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"r", ",", "1", ",", "j"}], "}"}]}], "]"}]}]}], 
             ";"}]}], "]"}], ";", "\[IndentingNewLine]", "a"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "3.", " ", "FILTRO", " ", "ESTRICTO", " ", "DE", " ", "SUBCADENAS", 
        " ", "R\[CapitalIAcute]GIDAS", " ", 
        RowBox[{"(", 
         RowBox[{
         "Criterio", " ", "de", " ", "Densidad", " ", "Topol\[OAcute]gica"}], 
         ")"}]}], "*)"}], 
      RowBox[{
       RowBox[{"FilterRigidSubchains", "[", 
        RowBox[{"adj_", "?", "MatrixQ"}], "]"}], ":=", 
       RowBox[{"Catch", "[", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", "ePrime", "}"}], ",", 
          RowBox[{"(*", 
           RowBox[{
           "Conectividad", " ", "global", " ", "para", " ", "eludir", " ", 
            "el", " ", "fraccionamiento", " ", "de", " ", "la", " ", 
            "cadena"}], "*)"}], 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"VertexConnectivity", "[", 
               RowBox[{"AdjacencyGraph", "[", "adj", "]"}], "]"}], "<", "2"}],
              ",", 
             RowBox[{"Throw", "[", "False", "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"Condici\[OAcute]n", " ", "ineludible", " ", "de", " ", 
             RowBox[{"subgrafos", ":", 
              RowBox[{
               RowBox[{"2", 
                RowBox[{"e", "'"}]}], "<=", 
               RowBox[{
                RowBox[{"3", 
                 RowBox[{"v", "'"}]}], "-", "4"}]}]}]}], "*)"}], 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Do", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"ePrime", "=", 
                  RowBox[{
                   RowBox[{"Total", "[", 
                    RowBox[{
                    RowBox[{"adj", "[", 
                    RowBox[{"[", 
                    RowBox[{"sv", ",", "sv"}], "]"}], "]"}], ",", "2"}], 
                    "]"}], "/", "2"}]}], ";", "\[IndentingNewLine]", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"2", "*", "ePrime"}], ">", 
                    RowBox[{
                    RowBox[{"3", "*", "k"}], "-", "4"}]}], ",", 
                   RowBox[{"Throw", "[", "False", "]"}]}], "]"}], ";"}], ",", 
                RowBox[{"{", 
                 RowBox[{"sv", ",", 
                  RowBox[{"Subsets", "[", 
                   RowBox[{
                    RowBox[{"Range", "[", "Nlinks", "]"}], ",", 
                    RowBox[{"{", "k", "}"}]}], "]"}]}], "}"}]}], "]"}], ";"}],
              ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "3", ",", 
               RowBox[{"Nlinks", "-", "1"}]}], "}"}]}], "]"}], ";", 
           "\[IndentingNewLine]", "True"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"GetDegreeSequences", "[", "famVals_", "]"}], ":=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"ConstantArray", "[", 
           RowBox[{
            RowBox[{"i", "+", "1"}], ",", 
            RowBox[{"famVals", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "famVals", "]"}]}], "}"}]}], "]"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
      "Print", "[", 
       "\"\<\\nProcesando matrices de adyacencia y depurando \
isomorfismos...\>\"", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "4.", " ", "Exploraci\[OAcute]n", " ", "y", " ", "Saturaci\[OAcute]n", 
        " ", "de", " ", "Secuencias", " ", "Topol\[OAcute]gicas"}], "*)"}], 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"degSeq", ",", 
            RowBox[{"validGraphsFam", "=", 
             RowBox[{"{", "}"}]}], ",", 
            RowBox[{"polyHashes", "=", 
             RowBox[{"{", "}"}]}], ",", "adj", ",", "pHash", ",", "g"}], 
           "}"}], ",", 
          RowBox[{
           RowBox[{"degSeq", "=", 
            RowBox[{"GetDegreeSequences", "[", 
             RowBox[{"vars", "/.", " ", 
              RowBox[{"families", "[", 
               RowBox[{"[", "f", "]"}], "]"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "Muestreo", " ", "estoc\[AAcute]stico", " ", "saturado", " ", 
             "sobre", " ", "el", " ", "espacio", " ", "param\[EAcute]trico", 
             " ", "de", " ", "secuencias"}], "*)"}], 
           RowBox[{"Quiet", "@", 
            RowBox[{"Do", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"g", "=", 
                RowBox[{"RandomGraph", "[", 
                 RowBox[{"DegreeGraphDistribution", "[", "degSeq", "]"}], 
                 "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"ConnectedGraphQ", "[", "g", "]"}], ",", 
                 RowBox[{
                  RowBox[{"adj", "=", 
                   RowBox[{"Normal", "[", 
                    RowBox[{"AdjacencyMatrix", "[", "g", "]"}], "]"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"FilterRigidSubchains", "[", "adj", "]"}], ",", 
                    RowBox[{
                    RowBox[{"pHash", "=", 
                    RowBox[{"BocherPolynomial", "[", "adj", "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                    RowBox[{
                    RowBox[{
                    "Si", " ", "el", " ", "polinomio", " ", "de", " ", 
                    "Bocher", " ", "es", " ", "nuevo"}], ",", 
                    RowBox[{
                    "es", " ", "estructuralmente", " ", "\[UAcute]nico"}]}], 
                    "*)"}], 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"!", 
                    RowBox[{"MemberQ", "[", 
                    RowBox[{"polyHashes", ",", "pHash"}], "]"}]}], ",", 
                    RowBox[{
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"polyHashes", ",", "pHash"}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"validGraphsFam", ",", "g"}], "]"}], ";"}], ",", 
                    RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"Ante", " ", "colisiones", " ", "polinomiales"}], 
                    ",", 
                    RowBox[{
                    "ejecutar", " ", "verificaci\[OAcute]n", " ", "de", " ", 
                    "isomorfismo", " ", "profunda"}]}], "*)"}], 
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Count", "[", 
                    RowBox[{"validGraphsFam", ",", 
                    RowBox[{"x_", "/;", 
                    RowBox[{"IsomorphicGraphQ", "[", 
                    RowBox[{"x", ",", "g"}], "]"}]}]}], "]"}], "==", "0"}], 
                    ",", 
                    RowBox[{
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"polyHashes", ",", "pHash"}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"validGraphsFam", ",", "g"}], "]"}], ";"}]}], 
                    "]"}], ";"}]}], "]"}], ";"}]}], "]"}], ";"}]}], "]"}], 
               ";"}], ",", 
              RowBox[{"{", "5000", "}"}]}], "]"}]}], ";", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{
             "La", " ", "saturaci\[OAcute]n", " ", "a", " ", "5000", " ", 
              "ciclos", " ", "basta", " ", "para", " ", "colapsar", " ", "el",
               " ", "espacio", " ", "en", " ", "N"}], "=", "8"}], "*)"}], 
           RowBox[{"validChains", "=", 
            RowBox[{"Join", "[", 
             RowBox[{"validChains", ",", "validGraphsFam"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{
            "\"\< -> Familia \>\"", ",", "f", ",", 
             "\"\< procesada. Cadenas v\[AAcute]lidas (KC): \>\"", ",", 
             RowBox[{"Length", "[", "validGraphsFam", "]"}]}], "]"}], ";"}]}],
          "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"f", ",", "1", ",", 
          RowBox[{"Length", "[", "families", "]"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "5.", " ", "Enumeraci\[OAcute]n", " ", "de", " ", "Inversiones", " ", 
        "Cinem\[AAcute]ticas", " ", 
        RowBox[{"(", 
         RowBox[{
         "C\[AAcute]lculo", " ", "de", " ", "\[CapitalOAcute]rbitas", " ", 
          "de", " ", "Simetr\[IAcute]a"}], ")"}]}], "*)"}], 
      RowBox[{
      "Print", "[", 
       "\"\<\\n======================================================\>\"", 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{
      "Print", "[", 
       "\"\<          RESULTADOS: MECANISMOS E INVERSIONES        \>\"", 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{
      "Print", "[", 
       "\"\<======================================================\>\"", 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"g", ",", "orbits", ",", "numInversions"}], "}"}], ",", 
          RowBox[{
           RowBox[{"g", "=", 
            RowBox[{"validChains", "[", 
             RowBox[{"[", "k", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"orbits", "=", 
            RowBox[{"GroupOrbits", "[", 
             RowBox[{
              RowBox[{"GraphAutomorphismGroup", "[", "g", "]"}], ",", 
              RowBox[{"VertexList", "[", "g", "]"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"numInversions", "=", 
            RowBox[{"Length", "[", "orbits", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"totalMechanisms", "+=", "numInversions"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{
            "\"\<Cadena [\>\"", ",", "k", ",", 
             "\"\<] | Inversiones \[UAcute]nicas: \>\"", ",", 
             "numInversions"}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"\"\<   Grafo: \>\"", ",", 
               RowBox[{"Graph", "[", 
                RowBox[{"g", ",", 
                 RowBox[{"VertexLabels", "->", "\"\<Name\>\""}], ",", 
                 RowBox[{"ImageSize", "->", "150"}]}], "]"}]}], "}"}], "]"}], 
            "]"}], ";"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", 
          RowBox[{"Length", "[", "validChains", "]"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
      "Print", "[", "\"\<\\nResumen Topol\[OAcute]gico Final:\>\"", "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<Total de Cadenas Cinem\[AAcute]ticas \[CapitalUAcute]nicas (KC): \
\>\"", ",", 
        RowBox[{"Length", "[", "validChains", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<Total de Inversiones Cinem\[AAcute]ticas (Mecanismos): \>\"", ",",
         "totalMechanisms"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{
      "Print", "[", 
       "\"\<======================================================\>\"", 
       "]"}], ";"}]}], "]"}]}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
